---
import '../styles/demo-return.css';
interface Props { titleTarget: string }
const { titleTarget } = Astro.props;
---
<nav class="demo-return" aria-label="Return navigation" data-visible="false" inert>
  <a class="floating-capsule" href="#" aria-label="Scroll to top" data-focus-target={titleTarget} data-scroll-top>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V5m-6 6 6-6 6 6" /></svg>
    <span class="demo-return-tip" aria-hidden="true">Scroll to top</span>
  </a>
  <a class="floating-capsule" href="/" aria-label="Return to home">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m4 11 8-7 8 7M6 10v10h5v-6h2v6h5V10" /></svg>
    <span class="demo-return-tip" aria-hidden="true">Return to home</span>
  </a>
</nav>
<script>
  const nav = document.querySelector<HTMLElement>('.demo-return');
  const sections = document.querySelector<HTMLElement>('[data-section-nav]');
  const topLink = nav?.querySelector<HTMLAnchorElement>('[data-scroll-top]');
  const title = document.getElementById(topLink?.dataset.focusTarget ?? '');
  if (nav && title && topLink) {
    let frame = 0;
    const update = () => {
      frame = 0;
      const visible = scrollY > Math.min(240, innerHeight * .4) && sections?.dataset.open !== 'true' && !document.querySelector('dialog[open]');
      if (!visible && nav.contains(document.activeElement)) title.focus({ preventScroll: true });
      nav.dataset.visible = String(visible);
      nav.inert = !visible;
    };
    const schedule = () => { if (!frame) frame = requestAnimationFrame(update); };
    const focusTitle = () => { title.tabIndex = -1; title.focus({ preventScroll: true }); };
    const observer = new MutationObserver(update);
    if (sections) observer.observe(sections, { attributes: true, attributeFilter: ['data-open'] });
    document.querySelectorAll('dialog').forEach(dialog => observer.observe(dialog, { attributes: true, attributeFilter: ['open'] }));
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    topLink.addEventListener('click', focusTitle);
    schedule();
    const dispose = () => {
      cancelAnimationFrame(frame); observer.disconnect();
      window.removeEventListener('scroll', schedule);
      window.removeEventListener('resize', schedule);
      topLink.removeEventListener('click', focusTitle);
    };
    document.addEventListener('astro:before-swap', dispose, { once: true });
    window.addEventListener('pagehide', event => { if (!event.persisted) dispose(); }, { once: true });
  }
</script>

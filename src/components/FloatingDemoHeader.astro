---
import '../styles/floating-header.css';
interface Props {
	title: string;
	publication: string;
	titleTarget: string;
	resourcesTarget: string;
}
const { title, publication, titleTarget, resourcesTarget } = Astro.props;
---

<header class="demo-floating-header" aria-label="Paper navigation">
	<div class="floating-capsule demo-title-capsule" data-source={titleTarget} data-visible="false" inert>
		<a class="demo-capsule-title" href={`#${titleTarget}`} title={title} aria-label={`Back to title: ${title}`}>
			<span class="demo-capsule-paper-title">{title}</span>
			<span class="demo-capsule-publication">{publication}</span>
		</a>
	</div>
	<div class="floating-capsule demo-resources-capsule" data-source={resourcesTarget} data-visible="false" inert>
		<slot />
	</div>
</header>

<script>
	import '../scripts/home-glass.js';
	const disposers: Array<() => void> = [];
	document.querySelectorAll<HTMLElement>('.demo-floating-header [data-source]').forEach((capsule) => {
		const source = document.getElementById(capsule.dataset.source ?? '');
		const header = capsule.parentElement;
		if (!source || !header) return;
		let observer: IntersectionObserver | undefined;
		let classObserver: MutationObserver | undefined;
		let lastEntry: IntersectionObserverEntry | undefined;
		// The phone audio player reserves room beside the floating resources
		// capsule, so the capsule must stay visible whenever that player exists
		// instead of hiding behind its source section.
		const keepForPlayer = () => capsule.classList.contains('demo-resources-capsule') && document.body.classList.contains('has-mobile-audio-player');
		const observeSource = () => {
			observer?.disconnect();
			// Treat the fixed capsule's footprint as the top of the reading area.
			// This also keeps links reachable on short papers in tall windows.
			// Treat the floating title row's footprint as the top of the reading
			// area. On compact screens the resources capsule floats from the
			// bottom-right corner, so its own box no longer marks where the
			// reading area begins.
			const anchor = header.querySelector<HTMLElement>('.demo-title-capsule') ?? capsule;
			const topBoundary = anchor.offsetTop + anchor.offsetHeight + header.getBoundingClientRect().top + 8;
			const evaluate = (entry?: IntersectionObserverEntry) => {
				if (entry) lastEntry = entry;
				// Sources below the viewport must not trigger a floating copy.
				const visible = keepForPlayer() || (!!lastEntry && !lastEntry.isIntersecting && lastEntry.boundingClientRect.bottom < topBoundary);
				if (!visible && capsule.contains(document.activeElement)) {
					(source.querySelector<HTMLElement>('a') ?? source).focus({ preventScroll: true });
				}
				capsule.dataset.visible = String(visible);
				capsule.inert = !visible;
			};
			observer = new IntersectionObserver(entries => evaluate(entries[0]), {
				threshold: 0,
				// Keep anchor jumps observable even when they skip the viewport.
				rootMargin: `-${topBoundary}px 0px ${document.documentElement.scrollHeight}px 0px`
			});
			observer.observe(source);
			if (capsule.classList.contains('demo-resources-capsule')) {
				classObserver?.disconnect();
				classObserver = new MutationObserver(() => evaluate());
				classObserver.observe(document.body, { attributes: true, attributeFilter: ['class'] });
			}
		};
		const sizeObserver = new ResizeObserver(observeSource);
		sizeObserver.observe(header);
		// Disconnect the latest observer, including replacements after reflow.
		disposers.push(() => {
			observer?.disconnect();
			classObserver?.disconnect();
			sizeObserver.disconnect();
		});
	});
	const dispose = () => disposers.forEach(disposeObserver => disposeObserver());
	document.addEventListener('astro:before-swap', dispose, { once: true });
	window.addEventListener('pagehide', (event) => { if (!event.persisted) dispose(); }, { once: true });
</script>

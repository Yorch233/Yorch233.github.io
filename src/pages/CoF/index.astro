---
import PaperLayout from '../../components/PaperLayout.astro';
import PaperHero from '../../components/PaperHero.astro';
import PaperSection from '../../components/PaperSection.astro';
import PaperCitation from '../../components/PaperCitation.astro';
import UiIcon from '../../components/UiIcon.astro';
import CoFResults from '../../components/preact/CoFResults.jsx';
import AudioDemoIsland from '../../components/preact/AudioDemoIsland.jsx';
import { publications } from '../../data/publications.js';
import { getFullTextLinks } from '../../lib/publication-links.js';
import { audioGroups, budgetOptions, methodOptions } from '../../data/cof-audio.js';
import '../../styles/cof.css';
import '../../styles/cof-results.css';
import '../../styles/audio-demo.css';

const publication = publications.find(paper => paper.slug === 'CoF')!;
const resources = [
	...getFullTextLinks(publication),
	{ href: 'https://github.com/Yorch233/CoF/', icon: 'github', label: 'GitHub', ariaLabel: 'View source code on GitHub', title: 'GitHub' },
	{ href: 'https://huggingface.co/Yorch233/CoF', icon: 'huggingface', label: 'Hugging Face', ariaLabel: 'View models on Hugging Face', title: 'Hugging Face', wide: true },
	{ href: 'https://www.modelscope.cn/models/Yorch233/CoF', icon: 'modelscope', label: 'ModelScope', ariaLabel: 'View models on ModelScope', title: 'ModelScope' }
];
---

<PaperLayout publication={publication} resources={resources} description="Demo for Corrective Forcing (CoF), with interactive benchmark results, NFE curves and model resources for diffusion and flow speech enhancement.">
  <PaperHero publication={publication} resources={resources} method="Corrective Forcing" kicker="Paper Demo" corresponding={['Qirong Mao']} linksTitle="Quick links">
		<aside class="cof-news">
			<UiIcon id="announcement" state="active" class="cof-news-icon" />
			<div class="cof-news-content">
			<span class="cof-news-tag">News</span>
			<p class="cof-news-text">
				Inference code and checkpoints are now open-sourced on{' '}
				<a href="https://github.com/Yorch233/CoF/" target="_blank" rel="noreferrer">GitHub</a>,{' '}
				<a href="https://huggingface.co/Yorch233/CoF" target="_blank" rel="noreferrer">Hugging Face</a>, and{' '}
				<a href="https://www.modelscope.cn/models/Yorch233/CoF" target="_blank" rel="noreferrer">ModelScope</a>.
			</p>
			</div>
		</aside>
	</PaperHero>

	<PaperSection variant="cof" headingId="cof-abstract-heading" label="Abstract" class="cof-fade">
		<div class="cof-abstract-wrap">
			<p class="cof-abstract">
				<span class="cof-highlight">Diffusion and flow models</span>, as promising generative paradigms
				for speech enhancement, face a <span class="cof-issue">training–inference mismatch</span>:
				training uses analytical path states, whereas inference recursively evaluates models on
				self-generated rollout states along discretized sampling
				trajectories. This mismatch causes{' '}
				<span class="cof-issue">prediction and discretization errors to accumulate</span>. To address it,
				we introduce <span class="cof-highlight">Corrective Forcing (CoF)</span>, a{' '}
				<span class="cof-highlight">post-training paradigm</span> that forces diffusion and flow models
				to learn from <span class="cof-highlight">self-generated rollouts</span> and correct their predictions. CoF corrects clean-speech predictions
				on rollout states toward the ground truth under dynamic sampling schedules, exposing the model to
				varying inference conditions. It further regularizes local evolution using{' '}
				<span class="cof-highlight">locally corrected counterfactual transitions</span> as references for
				factual transitions. By expressing model outputs through a shared{' '}
				<span class="cof-highlight">clean-speech prediction parameterization</span>, CoF applies the same
				post-training objective across diffusion and flow formulations. Experiments with SB-VE and OT-CFM
				demonstrate improvements in perceptual quality and reconstruction fidelity, together with robust
				performance across different numbers of sampling steps.
			</p>
			<div class="cof-legend" aria-hidden="true">
				<span class="cof-legend-item">
					<span class="cof-legend-swatch cof-legend-swatch-highlight"></span>
					Key Concepts
				</span>
				<span class="cof-legend-item">
					<span class="cof-legend-swatch cof-legend-swatch-issue"></span>
					Challenges
				</span>
			</div>
		</div>
	</PaperSection>

	<PaperSection variant="cof" headingId="cof-keywords-heading" label="Key Words" separated={false} class="cof-fade">
		<div class="cof-meta">
			<span class="cof-chip">Generative speech enhancement</span>
			<span class="cof-chip">Schrödinger bridge</span>
			<span class="cof-chip">Flow matching</span>
			<span class="cof-chip">Post-training methods</span>
			<span class="cof-chip">Exposure bias</span>
		</div>
	</PaperSection>

	<PaperSection variant="cof" headingId="cof-audio-heading" label="Audio Samples" class="cof-fade">
		<p class="cof-results-intro">
			Listen to <span class="cof-accent">10 samples</span> from both datasets. Every sample compares the pretrained
			formulation with its CoF post-trained counterpart. Use the sampling-budget toggles to hear the same samples at{' '}
			<span class="cof-accent">1 NFE</span> and <span class="cof-accent">4 NFE</span>.
		</p>
		<AudioDemoIsland
			client:visible
			groups={audioGroups}
			methods={methodOptions}
			budgets={budgetOptions}
		/>
	</PaperSection>

	<PaperSection variant="cof" headingId="cof-results-heading" label="Results" class="cof-fade">
		<p class="cof-results-intro">
			Compare pretrained and CoF post-trained models on <span class="cof-accent">WSJ0+WHAM</span> (denoising) and{' '}
			<span class="cof-accent">WSJ0+REVERB</span> (dereverberation). <span class="cof-accent">Chart view</span> benchmarks
			all five metrics at one sampling budget, and <span class="cof-accent">Curves view</span> traces each metric over NFE
			(number of function evaluations).
		</p>
		<CoFResults client:visible />
	</PaperSection>
  <PaperCitation variant="cof" headingId="cof-citation-heading" bibtex={publication.bibtex} />
</PaperLayout>

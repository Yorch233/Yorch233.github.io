---
import BaseLayout from '../layouts/BaseLayout.astro';
import UiIcon from '../components/UiIcon.astro';
import IconPreview from '../components/preact/IconPreview.jsx';
import { uiIconCatalog } from '../lib/ui-icon-catalog.js';
import '../styles/icon-gallery.css';
const groups = [...new Set(uiIconCatalog.map(icon => icon.group))];
const variants = [['active-filled', 'Active · two-tone fill'], ['inactive', 'Inactive · gray outline']];
const references: Record<string, string[]> = {
 Navigation: ['01-navigation'], Research: ['09-research-v2'], Actions: ['03-resource-actions', '04-controls'],
 Audio: ['05-audio'], Charts: ['06-charts'], Appearance: ['07-appearance'], Directions: ['08-directions'],
};
---
<BaseLayout title="Qing UI — Icon library" description="Rounded icons for Qing Yao's homepage and paper demos, with colored active and gray inactive states." bodyClass="icon-gallery">
 <main class="icon-gallery-main">
  <a class="icon-gallery-back" href="/"><UiIcon id="arrow-left" />Qing Yao</a>
  <header class="icon-gallery-header">
   <p class="icon-gallery-kicker">QING UI · SVG ICON LIBRARY</p>
   <h1>Simple symbols. Clear states.</h1>
   <p>{uiIconCatalog.length} precise icons. Two-tone fill when active. Gray outlines when inactive.<br />Designed for clarity at 16, 20 and 24px.</p>
  </header>
  <section class="icon-gallery-demo" aria-labelledby="icon-demo-title">
   <h2 id="icon-demo-title">Try the states</h2><IconPreview client:load />
  </section>
  <div class="icon-gallery-legend" aria-hidden="true"><span><i class="legend-active"></i>Active · two-tone fill</span><span><i class="legend-inactive"></i>Inactive · gray outline</span></div>
  <div class="icon-gallery-search"><label for="icon-search">Find an icon</label><input id="icon-search" type="search" placeholder="Search name or ID" autocomplete="off" /><span id="icon-search-count" role="status">{uiIconCatalog.length} icons</span></div>
  {groups.map(group => <section class="icon-gallery-group" aria-labelledby={`icon-group-${group.toLowerCase()}`}>
   <div class="icon-group-heading"><h2 id={`icon-group-${group.toLowerCase()}`}>{group}</h2><span>{references[group].map((key, i) => <a href={`/icons/references/${key}.png`} target="_blank" rel="noreferrer">{references[group].length > 1 ? `Generated reference ${i + 1}` : 'Generated reference'}<UiIcon id="external" /></a>)}</span></div>
   <div class="icon-gallery-grid">{uiIconCatalog.filter(icon => icon.group === group).map(icon => <article class="icon-gallery-card" data-icon-search={`${icon.id} ${icon.label}`.toLowerCase()}>
    <div class="icon-gallery-variants">{variants.map(([state, label]) => <a href={`/icons/${icon.id}-${state}.svg`} download aria-label={`Download ${icon.label}, ${label}`} title={`Download ${label}`}><img src={`/icons/${icon.id}-${state}.svg`} alt="" width="28" height="28" loading="lazy" /></a>)}</div>
    <h3>{icon.label}</h3><code>{icon.id}</code>
   </article>)}</div>
  </section>)}
  <footer class="icon-gallery-footer"><p>Tap any icon to download its SVG. Each drawing uses a native 24px grid and a transparent background.</p><a href="/icons/manifest.json" download>Download asset manifest</a><p>Native SVG artwork refined from imagegen references. Familiar brand silhouettes are preserved.</p></footer>
 </main>
</BaseLayout>

<script>
 const input = document.querySelector<HTMLInputElement>('#icon-search');
 const count = document.querySelector('#icon-search-count');
 const cards = [...document.querySelectorAll<HTMLElement>('[data-icon-search]')];
 input?.addEventListener('input', () => {
  const query = input.value.trim().toLowerCase();
  cards.forEach(card => { card.hidden = !card.dataset.iconSearch?.includes(query); });
  document.querySelectorAll<HTMLElement>('.icon-gallery-group').forEach(group => { group.hidden = !group.querySelector('.icon-gallery-card:not([hidden])'); });
  if (count) count.textContent = `${cards.filter(card => !card.hidden).length} ${cards.filter(card => !card.hidden).length === 1 ? 'icon' : 'icons'}`;
 });
</script>

---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import profile from '../data/profile.json';
import { publications } from '../data/publications.js';
import '../styles/home.css';

const rsb = publications.find((publication) => publication.slug === 'RSB') ?? publications[0];
const year = new Date().getFullYear();
---

<BaseLayout
	title="Qing Yao — Speech Enhancement & Diffusion Generative Modeling"
	description="Qing Yao (Jiangsu University). Research on speech enhancement with diffusion generative models: Schrödinger bridges, masked diffusion models, and audio codecs."
	bodyClass="home-ref"
>
	<Fragment slot="head">
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400&display=swap"
			rel="stylesheet"
		/>
	</Fragment>

	<a class="skip-link" href="#about">Skip to content</a>

	<!-- ---------- inline icon sprite (feather-style, MIT) ---------- -->
	<svg width="0" height="0" style="position:absolute" aria-hidden="true">
		<symbol id="i-mail" viewBox="0 0 24 24"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="m22 6-10 7L2 6" /></symbol>
		<symbol id="i-github" viewBox="0 0 16 16"><path class="icon-fill" stroke="none" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z" /></symbol>
		<symbol id="i-cap" viewBox="0 0 24 24"><path d="m2 10 10-5 10 5-10 5L2 10z" /><path d="M6 12.5V17c3.5 2.8 8.5 2.8 12 0v-4.5" /><path d="M22 10v6" /></symbol>
		<symbol id="i-file" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><path d="M14 2v6h6" /><line x1="16" y1="13" x2="8" y2="13" /><line x1="16" y1="17" x2="8" y2="17" /></symbol>
		<symbol id="i-download" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><path d="m7 10 5 5 5-5" /><path d="M12 15V3" /></symbol>
		<symbol id="i-external" viewBox="0 0 24 24"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" /><path d="M15 3h6v6" /><path d="M10 14 21 3" /></symbol>
		<symbol id="i-star" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" /></symbol>
		<symbol id="i-pin" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" /><circle cx="12" cy="10" r="3" /></symbol>
		<symbol id="i-code" viewBox="0 0 24 24"><polyline points="16 18 22 12 16 6" /><polyline points="8 6 2 12 8 18" /></symbol>
		<symbol id="i-audio" viewBox="0 0 24 24"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5" /><path d="M15.54 8.46a5 5 0 0 1 0 7.07" /><path d="M19.07 4.93a10 10 0 0 1 0 14.14" /></symbol>
		<symbol id="i-copy" viewBox="0 0 24 24"><rect x="8" y="8" width="11" height="11" rx="2" /><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2" /></symbol>
	</svg>

	<!-- ---------- top bar ---------- -->
	<header class="topbar">
		<a class="brand" href="#about">
			<span class="mono-badge">{profile.monogram}</span>{profile.name}
		</a>
		<nav class="topnav" aria-label="Primary">
			<a href="#about">About</a>
			<a href="#news">News</a>
			<a href="#publications">Publications</a>
			<a href="#projects">Projects</a>
			<a href="#contact">Contact</a>
			<a
				class="cv-btn tip tip-below"
				data-disabled
				aria-disabled="true"
				data-tip="CV is being prepared — please check back soon"
				title="CV is being prepared — please check back soon"
			>
				<svg class="icon" aria-hidden="true"><use href="#i-download" /></svg>CV
			</a>
		</nav>
	</header>

	<div class="layout">

		<!-- ================= sidebar ================= -->
		<aside class="sidebar">
			<div class="avatar">
				<img src={profile.avatar} width="300" height="300" alt={"Portrait of " + profile.name} />
			</div>

			<div>
				<h1 class="side-name">{profile.name}</h1>
				<p class="side-role">{profile.role}</p>
				<p class="side-affil">{profile.contact.institution}<br />{profile.location}</p>
			</div>

			<div class="side-divider" role="presentation"></div>

			<div class="interests" aria-label="Research interests">
				{
					profile.interests.map((interest) => (
						<span class="chip">{interest}</span>
					))
				}
			</div>

			<div class="side-links">
				<a href={"mailto:" + profile.contact.email}>
					<svg class="icon" aria-hidden="true"><use href="#i-mail" /></svg>Email
				</a>
				<a href={profile.contact.github} target="_blank" rel="noopener">
					<svg class="icon" aria-hidden="true"><use href="#i-github" /></svg>GitHub
				</a>
				<a href={profile.contact.huggingFace} target="_blank" rel="noopener">
					<Icon name="simple-icons:huggingface" class="icon-hf" aria-hidden="true" />Hugging Face
				</a>
			</div>
		</aside>

		<!-- ================= main ================= -->
		<main>

			<!-- about / hero -->
			<section id="about" class="hero" aria-label="About">
				<!-- keep each "word <span>…</span>" unit on one line: Astro's default
					normalization drops whitespace that spans a newline next to a tag -->
				<p class="lede reveal">
					I'm a PhD student at <span class="accent">{profile.contact.institution}</span> working on <span class="accent">diffusion-based generative models</span> for <span class="accent">speech enhancement</span>, particularly <span class="accent">Schrödinger bridges</span> and <span class="accent">masked diffusion models</span>. Speech enhancement is inherently an ill-posed inverse problem, where a degraded observation may correspond to multiple plausible clean-speech signals. My research explores generative approaches to address this ill-posedness while balancing reconstruction fidelity, perceptual naturalness, and computational efficiency.
				</p>
				<div class="meta reveal">
					<span><svg class="icon" aria-hidden="true"><use href="#i-pin" /></svg>{profile.location}</span>
					<span><svg class="icon" aria-hidden="true"><use href="#i-cap" /></svg>Advisor: {profile.advisor}</span>
				</div>
				<div class="cta-row reveal">
					<a
						class="btn btn-primary tip"
						data-disabled
						aria-disabled="true"
						data-tip="CV is being prepared — please check back soon"
						title="CV is being prepared — please check back soon"
					>
						<svg class="icon" aria-hidden="true"><use href="#i-download" /></svg>Download CV
					</a>
					<a class="btn btn-ghost" href={"mailto:" + profile.contact.email}>
						<svg class="icon" aria-hidden="true"><use href="#i-mail" /></svg>Email me
					</a>
					<a class="btn btn-ghost" href={profile.contact.github} target="_blank" rel="noopener">
						<svg class="icon" aria-hidden="true"><use href="#i-github" /></svg>GitHub
					</a>
				</div>
			</section>

			<!-- news -->
			<section id="news">
				<div class="sec-head reveal">
					<span class="mark" aria-hidden="true"></span>
					<h2>News</h2>
					<span class="rule" aria-hidden="true"></span>
				</div>
				<ul class="news reveal">
					{
						profile.news.map((item) => (
							<li>
								<span class="date">{item.date}</span>
								<p set:html={item.html} />
							</li>
						))
					}
				</ul>
			</section>

			<!-- publications -->
			<section id="publications">
				<div class="sec-head reveal">
					<span class="mark" aria-hidden="true"></span>
					<h2>Publications</h2>
					<span class="rule" aria-hidden="true"></span>
				</div>

				<article class="pub reveal">
					<div class="pub-year">{rsb.year}</div>
					<div>
						<h3 class="pub-title">
							<a href={rsb.paper} target="_blank" rel="noopener">{rsb.title}</a>
							<span class="badge badge-hl">{rsb.badge}</span>
						</h3>
						<p class="pub-authors">
							{
								rsb.authors.map((author, index) => (
									<Fragment>
										{index > 0 ? ', ' : null}
										{author.highlight ? <b>{author.name}</b> : author.name}
									</Fragment>
								))
							}
							— <span class="venue">{rsb.venueFull}</span>
						</p>
						<p class="pub-links">
							<a class="link-pill" href={rsb.paper} target="_blank" rel="noopener">
								<svg class="icon" aria-hidden="true"><use href="#i-file" /></svg>IEEE
							</a>
							<a class="link-pill" href={rsb.arxiv} target="_blank" rel="noopener">
								<svg class="icon" aria-hidden="true"><use href="#i-external" /></svg>arXiv
							</a>
							<a class="link-pill" href={rsb.code} target="_blank" rel="noopener">
								<svg class="icon" aria-hidden="true"><use href="#i-code" /></svg>Code
							</a>
							<a class="link-pill" href={rsb.demo}>
								<svg class="icon" aria-hidden="true"><use href="#i-audio" /></svg>Audio Demo
							</a>
							<button class="link-pill link-pill-copy" type="button" data-copy-bib={rsb.slug} aria-label="Copy BibTeX to clipboard">
								<svg class="icon" aria-hidden="true"><use href="#i-copy" /></svg><span class="link-pill-label">BibTeX</span>
							</button>
						</p>
					</div>
				</article>

				<p class="pub-note reveal">More papers and preprints coming soon.</p>
			</section>

			<!-- projects -->
			<section id="projects">
				<div class="sec-head reveal">
					<span class="mark" aria-hidden="true"></span>
					<h2>Projects &amp; Open Source</h2>
					<span class="rule" aria-hidden="true"></span>
				</div>
				<div class="proj-grid">
					{
						profile.projects.map((project) => (
							<a
								class="proj reveal"
								href={project.url}
								target={project.url.startsWith('/') ? undefined : '_blank'}
								rel={project.url.startsWith('/') ? undefined : 'noopener'}
							>
								<h3>
									<svg class="icon" aria-hidden="true"><use href={"#" + project.icon} /></svg>{project.name}
								</h3>
								<p>{project.description}</p>
								<div class="foot">
									{project.language ? <span>{project.language}</span> : null}
									{
										project.stars ? (
											<span class="star">
												<svg class="icon" aria-hidden="true"><use href="#i-star" /></svg>{project.stars}
											</span>
										) : null
									}
									{project.meta ? <span>{project.meta}</span> : null}
								</div>
							</a>
						))
					}
				</div>
			</section>

			<!-- contact -->
			<section id="contact">
				<div class="sec-head reveal">
					<span class="mark" aria-hidden="true"></span>
					<h2>Contact</h2>
					<span class="rule" aria-hidden="true"></span>
				</div>
				<div class="contact-box reveal">
					<h3>Get in touch</h3>
					<p>
						I'm always happy to discuss. Email is the best way to reach me.
						I usually reply within a few days.
					</p>
					<a class="contact-mail" href={"mailto:" + profile.contact.email}>{profile.contact.email}</a>
					<div class="contact-social">
						<a href={profile.contact.github} target="_blank" rel="noopener" aria-label="GitHub">
							<svg class="icon" aria-hidden="true"><use href="#i-github" /></svg>
						</a>
						<a href={"mailto:" + profile.contact.email} aria-label="Email">
							<svg class="icon" aria-hidden="true"><use href="#i-mail" /></svg>
						</a>
						<a href={profile.contact.huggingFace} target="_blank" rel="noopener" aria-label="Hugging Face">
							<Icon name="simple-icons:huggingface" class="icon-hf" aria-hidden="true" />
						</a>
					</div>
				</div>
			</section>

		</main>
	</div>

	<footer>
		<span class="foot-wave" aria-hidden="true">∿ ∿ ∿</span>
		© <span id="year">{year}</span> {profile.name} · {profile.contact.institution} · Built with Astro
	</footer>

	<script>
		(() => {
			'use strict';

			/* 1. Scrollspy for the top navigation. */
			const navLinks = Array.from(document.querySelectorAll('.topnav a[href^="#"]'));
			const sections = navLinks
				.map((a) => a.getAttribute('href'))
				.filter((href): href is string => typeof href === 'string' && href !== '')
				.map((href) => document.querySelector(href))
				.filter((s): s is Element => s !== null);
			if (navLinks.length && 'IntersectionObserver' in window) {
				const spy = new IntersectionObserver(
					(entries) => {
						entries.forEach((e) => {
							if (e.isIntersecting) {
								navLinks.forEach((a) =>
									a.classList.toggle('active', a.getAttribute('href') === '#' + e.target.id)
								);
							}
						});
					},
					{ rootMargin: '-35% 0px -55% 0px' }
				);
				sections.forEach((s) => spy.observe(s));
			}

			/* 2. Subtle scroll-reveal for sections. */
			const reveals = document.querySelectorAll('.reveal');
			if (
				reveals.length &&
				'IntersectionObserver' in window &&
				!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches)
			) {
				const io = new IntersectionObserver(
					(entries) => {
						entries.forEach((e) => {
							if (e.isIntersecting) {
								e.target.classList.add('on');
								io.unobserve(e.target);
							}
						});
					},
					{ threshold: 0.12 }
				);
				reveals.forEach((el) => io.observe(el));
			} else {
				reveals.forEach((el) => el.classList.add('on'));
			}

			/* 3. Footer year. */
			const yearEl = document.getElementById('year');
			if (yearEl) yearEl.textContent = String(new Date().getFullYear());
		})();
	</script>

	<script>
		import { publications } from '../data/publications.js';

		const bibs = Object.fromEntries(
			publications.filter((p) => p.bibtex).map((p) => [p.slug, p.bibtex])
		);

		document.querySelectorAll<HTMLButtonElement>('button[data-copy-bib]').forEach((button) => {
			button.addEventListener('click', async () => {
				const slug = button.dataset.copyBib;
				const text = slug ? bibs[slug] : undefined;
				if (!text) return;
				try {
					await navigator.clipboard.writeText(text);
				} catch {
					const area = document.createElement('textarea');
					area.value = text;
					area.style.position = 'fixed';
					area.style.opacity = '0';
					document.body.appendChild(area);
					area.select();
					// execCommand is deprecated, but this is the last-resort fallback
					(document as unknown as { execCommand: (id: string) => boolean }).execCommand('copy');
					area.remove();
				}
				const label = button.querySelector('.link-pill-label');
				if (!label) return;
				const original = label.textContent;
				label.textContent = 'Copied!';
				button.classList.add('is-copied');
				setTimeout(() => {
					label.textContent = original;
					button.classList.remove('is-copied');
				}, 1600);
			});
		});
	</script>
</BaseLayout>

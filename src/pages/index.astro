---
import UiIcon from '../components/UiIcon.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MeetYo from '../components/preact/MeetYo.jsx';
import BaseLayout from '../layouts/BaseLayout.astro';
import profile from '../data/profile.json';
import { SITE_LOGO_URL } from '../lib/site-logo.js';
import '../styles/floating-header.css';
import '../styles/home.css';
import '../styles/home-cards.css';
import '../styles/home-contact.css';
import '../styles/home-clouds.css';
import '../styles/yo-welcome.css';

---

<BaseLayout
	title="Qing Yao - Generative Speech Enhancement"
	description="Qing Yao's personal homepage. PhD student at Jiangsu University researching speech enhancement and diffusion-based generative modeling. Meet him through Yo, his little cloud guide."
	bodyClass="home-ref"
>
	<div class="home-clouds" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
	<a class="skip-link" href="#main-content" data-yo-say="Jump straight to the content. I'm right here if you need me.">Skip to content</a>
	<div class="layout">
		<header class="topbar">
			<a class="brand floating-capsule" href="/" aria-label="Qing Yao, home" data-yo-say="Back to Qing's introduction. Nice to meet you!"><img class="brand-avatar" src={SITE_LOGO_URL} alt="" width="38" height="38" decoding="async" /><span>{profile.name}</span></a>
			<div class="header-tools">
			<nav class="actions-pill floating-capsule" aria-label="Primary" data-yo-say="Choose a section to explore Qing's work. I'll come along!">
				<div class="home-nav-links" id="home-nav-links">
				<a class="toplink" href="#about" aria-current="location" data-yo-say="Meet Qing and discover his research interests."><UiIcon id="user" /><span class="nav-label">About Me</span></a>
				<a class="toplink" href="#news" data-yo-say="The latest from Qing's research."><UiIcon id="news" /><span class="nav-label">News</span></a>
				<a class="toplink" href="#papers" data-yo-say="Qing's papers, code and Demos."><UiIcon id="file" /><span class="nav-label">Publications</span></a>
				<a class="toplink" href="#awards" data-yo-say="A few highlights from Qing's journey."><UiIcon id="trophy" /><span class="nav-label">Awards</span></a>
				<a class="toplink" href="#contact" data-yo-say="Here's how to reach Qing."><UiIcon id="mail" /><span class="nav-label">Contact</span></a>
				<span class="home-nav-indicator" aria-hidden="true"><span class="home-nav-glass" data-glass-depth="1.4"></span></span>
				</div>
			</nav>
			<div class="home-utilities" role="group" aria-label="CV and appearance">
				<a class="cv-btn floating-capsule" href="#contact" data-cv-request title="Request a CV by email" data-yo-say="Qing's CV isn't online yet. You can request a copy by email."><UiIcon id="cv" />CV</a>
				<button class="theme-toggle floating-capsule" type="button" aria-label="Switch to dark mode" aria-pressed="false" title="Switch to dark mode" data-yo-say="Light or dark? Pick the view that feels comfy.">
					<UiIcon id="moon" class="theme-moon" />
					<UiIcon id="sun" class="theme-sun" />
				</button>
			</div>
			</div>
		</header>
		<main id="main-content" tabindex="-1"><MeetYo client:load /></main>
		<SiteFooter class="home-footer" />
	</div>
	<script>
		import '../scripts/home-theme.js';
		import '../scripts/home-clouds.js';
		import '../scripts/home-glass.js';
		import '../scripts/home-nav-glass.js';

	</script>
</BaseLayout>

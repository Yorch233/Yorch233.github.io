		"@eslint/js": "^9.39.5",
		"@playwright/test": "^1.64.0",
		"@types/node": "^24.19.2",
		"eslint": "^9.39.4",
		"eslint-plugin-astro": "^1.7.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"globals": "^17.13.0",
		"sharp": "0.35.3",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.71.1",
		"vitest": "^3.2.7"
